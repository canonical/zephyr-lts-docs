# Single source of truth for the versions this documentation describes.
#
# This file is parsed by conf.py to generate the rst_epilog substitution
# macros used in the prose, and sourced into the environment by the
# `make cram` target (conf.py also injects it into `make doctest`), so the
# docs and the tests always assert against the same values. Bump these
# when the documentation targets a new release; any reference that was
# not updated will fail a test.

# The release this documentation covers.
DOC_VERSION=24.04
DOC_UPSTREAM_VERSION=3.7.2
DOC_LP_ZEPHYR_URL=https://git.launchpad.net/~arctic-tern/zephyr-rtos/+git
DOC_WEST_MIN_VERSION=1.5
SDK_NG_VERSION=0.16.9
SDK_NG_CHANNEL="$SDK_NG_VERSION"/stable
SOURCE_TAG=24.04.rc-1
UBUNTU_BASE_VERSION=26.04
DOC_PPA_NAME=arctic-tern/zephyr-toolchain-"$DOC_VERSION"
